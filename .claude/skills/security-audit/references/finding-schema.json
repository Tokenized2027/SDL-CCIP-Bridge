{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Audit Workstream Output",
  "type": "object",
  "required": ["workstream", "completedAt", "checks"],
  "properties": {
    "workstream": {
      "type": "string",
      "enum": ["AUTH", "RLS", "EXT", "INFRA", "CI", "INPUT", "AI", "SEC", "RATE", "MISC"]
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{2}$",
            "description": "Check ID, e.g. AUTH-01, RLS-10"
          },
          "name": {
            "type": "string",
            "description": "Short name of the check"
          },
          "status": {
            "enum": ["PASS", "FAIL", "NA"],
            "description": "PASS = secure, FAIL = vulnerability found, NA = not applicable"
          },
          "severity": {
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", null],
            "description": "Severity if FAIL, null if PASS or NA"
          },
          "files": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Relative file paths examined for this check"
          },
          "evidence": {
            "type": "string",
            "description": "What was found, with line numbers. Must reference actual code."
          },
          "cveRef": {
            "type": ["string", "null"],
            "description": "CVE ID if this check relates to a known CVE, null otherwise"
          },
          "suggestedFix": {
            "type": "string",
            "description": "Specific remediation recommendation"
          },
          "priorAuditMatch": {
            "enum": ["NEW", "RECURRING", "RESOLVED", "REGRESSED", null],
            "description": "Delta vs prior audit. Filled by synthesis phase, not by agents."
          }
        }
      }
    },
    "attackPaths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Multi-step attack chains identified within this workstream"
    },
    "positives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Things working well in this security domain"
    }
  }
}
